# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=replace-me
JWT_SECRET_KEY=replace-me

# Must use asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/beyo_manager
# Optional per-worktree test-database slot. Use a distinct lowercase [a-z0-9]{1,12}
# value when running pytest from a second checkout, for example BEYO_TEST_SLOT=alpha.
BEYO_TEST_SLOT=main
# One-time cleanup of pre-slot test database names, only when explicitly exported:
# BEYO_RECLAIM_LEGACY_TEST_DATABASES=1 PYTHONPATH=. pytest -m 'not e2e' -n 0

REDIS_URL=redis://localhost:6380/0
REDIS_KEY_PREFIX=beyo_manager

# App server port — auto-detected free port at generation time.
PORT=8000

# Docker Compose host ports — auto-detected free ports at generation time.
POSTGRES_PORT=5433
REDIS_PORT=6380

# Web Push (VAPID)
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CONTACT_EMAIL=admin@example.com

# External partner APIs
BEYO_VINTAGE_API_KEY=

# Location tracker integration (outbound). BASE_URL must be the host root (no path prefix).
LOCATION_TRACKER_API_KEY=
LOCATION_TRACKER_BASE_URL=
LOCATION_TRACKER_TIMEOUT_SECONDS=10

# Comma-separated for multiple origins
FRONTEND_ORIGINS=http://localhost:5173

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh cookie policy (local HTTP-safe defaults)
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_PATH=/
# AUTH_REFRESH_COOKIE_DOMAIN=
# AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=

# development | testing | production
ENVIRONMENT=development

# Optional settings profile selector used by config.py.
# Supported values: development | testing | validation | production
APP_ENV=development

# Database connection pool (tune for load; defaults shown are production-safe)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Idle sleep mode — disable for dedicated worker-only deployments
SLEEP_MODE_ENABLED=true
IDLE_SLEEP_THRESHOLD_SECONDS=600

# Storage — options: local | localstack | s3
# local:      files served through the app (development only, no cloud dependency)
# localstack: real S3 API against a local docker service (requires STORAGE_BUCKET)
# s3:         AWS S3 production (requires STORAGE_BUCKET + AWS credentials)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/tmp/beyo_manager-uploads
LOCAL_STORAGE_HOST=http://localhost:8000
# Required for localstack and s3 — leave blank for local
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT_URL=http://localhost:4566  # localstack only
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Destructive development endpoints — POST /api/v1/bootstrap,
# DELETE /api/v1/bootstrap/wipe-db and DELETE /api/v1/reset.
# Refused unless this is true AND ENVIRONMENT is explicitly development, testing,
# validation or staging. ENVIRONMENT=production refuses them regardless of this flag
# or any secret. Set to true locally to seed or reset a development database.
DESTRUCTIVE_ENDPOINTS_ENABLED=false

# Bootstrap — POST /api/v1/bootstrap (development tool, see above)
# Required to call POST /api/v1/bootstrap. Keep this secret and rotate after first use.
BOOTSTRAP_SECRET=replace-me
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me
BOOTSTRAP_WORKSPACE_NAME=My Workspace
BOOTSTRAP_WORKSPACE_TIMEZONE=UTC
# Initial password for the seeded worker accounts. Required by bootstrap; applied only
# when an account is first created, never to an existing one.
BOOTSTRAP_WORKER_PASSWORD=
# Optional seeded SMTP/IMAP mailbox. Leave either empty to skip the email seed.
# Never point a local or staging environment at a real production mailbox.
BOOTSTRAP_EMAIL_ADDRESS=
BOOTSTRAP_EMAIL_APP_PASSWORD=

# Reset — DELETE /api/v1/reset (development tool, see above)
# Leave empty to disable. Set to enable workspace reset endpoint (dev/test only).
RESET_SECRET=

# Background tasks that reach third parties: sending email, mailbox sync, Web Push,
# Shopify, Scanner (location tracker) and outbound webhooks. When false the task
# router cancels them instead of queueing them, and the email IDLE watcher will not
# start. Set false on every local and staging host. Defaults to true when unset so a
# host whose env predates this setting keeps its behaviour.
OUTBOUND_INTEGRATIONS_ENABLED=false

# Email IMAP IDLE watcher (beyo_manager.workers.email_idle_watcher).
# Off by default: when false the watcher process logs once and exits. It also stays
# off while OUTBOUND_INTEGRATIONS_ENABLED is false.
# This flag controls ONLY the long-lived IDLE watcher. It does not disable email:
# user-triggered sync and sending still run through the tasks worker.
EMAIL_IDLE_ENABLED=false

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
